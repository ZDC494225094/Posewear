# ---- 基础 ----
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# 站点对外地址，用于支付回调和邮件链接（也可在后台「站点设置」里填写）
PUBLIC_BASE_URL=https://your-domain.com

# 加密数据库中 API Key / 支付私钥用，至少 32 位。务必固定并妥善备份，丢失后已保存的密钥无法解密。
# 生成方法：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# 首次启动时自动创建的管理员账号（已存在则提升为管理员）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# ---- 存储 ----
# 数据目录：SQLite 数据库、用户上传、生成结果
DATA_DIR=./storage
# 素材图片根目录（包含 pose/ 和 costume/）。可直接指向原项目的 img 目录，或用导入脚本 --copy 复制过来
LIBRARY_DIR=./storage/library

# ---- 反向代理 ----
# 部署在 Nginx/Caddy 后面时保持 loopback；直接暴露端口时设为 false
TRUST_PROXY=loopback
# auto：按请求是否为 HTTPS 决定 Cookie 的 Secure 标记
COOKIE_SECURE=auto
# 统计与订单使用的时区偏移（分钟），默认东八区
TZ_OFFSET_MINUTES=480

# ---- 首次启动时预置的 AI 渠道（之后在后台「AI 渠道」中管理）----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
